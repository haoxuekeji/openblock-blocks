<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="varX">x</variable>
    <variable type="" id="varY">y</variable>
  </variables>
  <block type="event_whenflagclicked" id="s5hatstage" x="10" y="10">
    <next>
      <block type="motion_movesteps" id="s5b1">
        <value name="STEPS">
          <shadow type="math_number">
            <field name="NUM">10</field>
          </shadow>
        </value>
        <next>
          <block type="looks_say" id="s5b2">
            <value name="MESSAGE">
              <shadow type="text">
                <field name="TEXT">Hello!</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>
  <block type="event_whenmicropythonbegin" id="s5hatmp" x="10" y="300">
    <next>
      <block type="data_setvariableto" id="s5b3">
        <field name="VARIABLE" id="varX">x</field>
        <value name="VALUE">
          <shadow type="text">
            <field name="TEXT">1</field>
          </shadow>
        </value>
        <next>
          <block type="looks_think" id="s5b4">
            <value name="MESSAGE">
              <shadow type="text">
                <field name="TEXT">hmm...</field>
              </shadow>
            </value>
            <next>
              <block type="data_changevariableby" id="s5b5">
                <field name="VARIABLE" id="varX">x</field>
                <value name="VALUE">
                  <shadow type="math_number">
                    <field name="NUM">2</field>
                  </shadow>
                </value>
                <next>
                  <block type="data_setvariableto" id="s5b6">
                    <field name="VARIABLE" id="varY">y</field>
                    <value name="VALUE">
                      <shadow type="text">
                        <field name="TEXT"></field>
                      </shadow>
                      <block type="sensing_loudness" id="s5b7"></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
